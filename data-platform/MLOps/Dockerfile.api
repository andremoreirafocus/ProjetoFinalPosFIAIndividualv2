FROM python:3.12-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
# A estrutura de diretorios e preservada porque requirements.txt da API inclui os
# arquivos do Model e do infra por caminho relativo.
COPY infra/requirements.txt /tmp/infra/requirements.txt
COPY Model/requirements-inference.txt /tmp/Model/requirements-inference.txt
COPY MLOps/app/api/requirements.txt /tmp/MLOps/app/api/requirements.txt
RUN pip install --no-cache-dir -r /tmp/MLOps/app/api/requirements.txt
COPY MLOps /app/MLOps
COPY infra /app/infra
COPY Model/artifact_bundle_contract.py /app/Model/artifact_bundle_contract.py
COPY DataPipeline/sql /app/DataPipeline/sql

CMD ["uvicorn", "MLOps.app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
